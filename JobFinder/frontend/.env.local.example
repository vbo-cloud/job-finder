# Frontend environment variables (Next.js inlines NEXT_PUBLIC_* at build time).
# Copy to .env.local and fill in real values. Do NOT commit .env.local.

# Client ID of the SPA app registration (Entra External ID / CIAM).
NEXT_PUBLIC_ENTRA_CLIENT_ID=

# CIAM authority URL, e.g. https://<subdomain>.ciamlogin.com/<tenantId>
NEXT_PUBLIC_ENTRA_AUTHORITY=

# CIAM authority host, e.g. <subdomain>.ciamlogin.com
NEXT_PUBLIC_ENTRA_KNOWN_AUTHORITY=

# access_as_user scope exposed by the fastapi-jobfinder API app registration,
# e.g. api://<api-client-id>/access_as_user
NEXT_PUBLIC_ENTRA_API_SCOPE=

# Redirect URI registered for the SPA. Defaults to the current origin in the
# browser; set explicitly for non-default deployments.
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000

# Base URL of the FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostHog Cloud EU project (organisation vbo-cloud, project 231604). The key
# is a public client token, not a secret — kept in an env var for consistency
# with the rest of this file rather than hardcoded.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
