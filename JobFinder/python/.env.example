# Variables d'environnement requises pour faire tourner le projet localement.
# Copier ce fichier en .env et remplir les valeurs.

DATABASE_URL=
AZURE_OPENAI_ENDPOINT=
AZURE_SERVICEBUS_CONNECTION_STRING=
AZURE_STORAGE_CONNECTION_STRING=
FT_CLIENT_ID=
FT_CLIENT_SECRET=
# Optionnel — IDs utilisateur Entra (claim sub du JWT, = user_id renvoyé par GET /profile)
# séparés par des virgules, qui débloquent les fonctions admin (bouton +10 crédits).
ADMIN_USER_IDS=
# Secret HMAC partagé entre agents/notifications (signe) et agents/webapp (vérifie) pour
# le lien de désabonnement one-click (RFC 8058) — voir shared/unsubscribe_token.py.
NOTIFICATIONS_UNSUBSCRIBE_SECRET=
# URL publique du backend FastAPI lui-même (pas du frontend) — utilisée par
# agents/notifications pour construire ce même lien de désabonnement.
WEBAPP_BASE_URL=
