# Variables d'environnement requises pour faire tourner le projet localement.
# Copier ce fichier en .env et remplir les valeurs.

DATABASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_SERVICEBUS_CONNECTION_STRING=
AZURE_STORAGE_CONNECTION_STRING=
FT_CLIENT_ID=
FT_CLIENT_SECRET=
# Optionnel — IDs utilisateur Entra (claim sub du JWT, = user_id renvoyé par GET /profile)
# séparés par des virgules, qui débloquent les fonctions admin (bouton +10 crédits).
ADMIN_USER_IDS=
